# postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=concerts
POSTGRES_HOST=concert-postgres
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=5s

# redis
REDIS_ADDR=concert-redis:6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_TIMEOUT=2s

# minio / s3
S3_ENDPOINT=http://concert-minio:9000
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET_NAME=concerts
S3_USE_SSL=false
S3_REGION=us-east-1
S3_UPLOAD_MIN_MB=0
S3_UPLOAD_MAX_MB=50
S3_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# http
HTTP_ADDR=0.0.0.0:8080
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_CORS_ALLOWED_ORIGINS=https://your-domain
HTTP_CORS_ALLOW_CREDENTIALS=true
HTTP_CORS_MAX_AGE_SECONDS=600

# logger
LOGGER_LEVEL=INFO
LOGGER_FOLDER=/app/logs

# auth
AUTH_PASSWORD_SALT=change_me
AUTH_JWT_SIGNING_KEY=change_me
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_BOT_TOKEN=change_me

# minio cors
MINIO_CORS_ORIGINS=https://your-domain
